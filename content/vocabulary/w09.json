  "items": [
    {
      "id": "v-w09-01",
      "week": 9,
      "word": "伺{うかが}う",
      "reading": "うかがう",
      "partOfSpeech": "動詞",
      "meaningZh": "【謙讓語】① 拜訪（訪問する）② 請教、聽說（聞く）。",
      "examples": [
        {
          "jp": "明日{あした}三時{さんじ}に御社{おんしゃ}へ伺{うかが}います。",
          "zh": "明天三點到貴公司拜訪。"
        },
        {
          "jp": "一点{いってん}、伺{うかが}いたいことがあるのですが。",
          "zh": "有一點想向您請教。"
        }
      ],
      "difficulty": "N2-core",
      "tags": ["謙譲語", "ビジネス"],
      "note": "一個字有兩個意思，靠語境判斷：後面接場所是「拜訪」，接問題是「請教」。聽解常考這個判別。",
      "source": { "type": "original", "label": "自製" }
    },
    {
      "id": "v-w09-02",
      "week": 9,
      "word": "拝見{はいけん}",
      "reading": "はいけん",
      "partOfSpeech": "名詞",
      "meaningZh": "【謙讓語】看（見る）。做「拝見する」「拝見いたします」。",
      "examples": [
        {
          "jp": "資料{しりょう}、拝見{はいけん}いたしました。",
          "zh": "資料我已經看過了。"
        },
        {
          "jp": "差{さ}し支{つか}えなければ、拝見{はいけん}してもよろしいでしょうか。",
          "zh": "如果方便的話，我可以看一下嗎？"
        }
      ],
      "difficulty": "N2-core",
      "tags": ["謙譲語", "ビジネス"],
      "note": "主語一定是自己。對方看東西要用尊敬語「ご覧になる」，混用是高頻錯誤。",
      "relatedIds": ["v-w09-09"],
      "source": { "type": "original", "label": "自製" }
    },
    {
      "id": "v-w09-03",
      "week": 9,
      "word": "承{うけたまわ}る",
      "reading": "うけたまわる",
      "partOfSpeech": "動詞",
      "meaningZh": "【謙讓語】接受、聽取（受ける・聞く）。多用於接受訂單或委託。",
      "examples": [
        {
          "jp": "ご注文{ちゅうもん}を承{うけたまわ}りました。",
          "zh": "您的訂單我們已經接受了。"
        },
        {
          "jp": "ご意見{いけん}は確{たし}かに承{うけたまわ}りました。",
          "zh": "您的意見我確實收到了。"
        }
      ],
      "difficulty": "N2-advanced",
      "tags": ["謙譲語", "ビジネス"],
      "note": "讀音很長也很容易忘，但客服與商務場面幾乎必出。",
      "source": { "type": "original", "label": "自製" }
    },
    {
      "id": "v-w09-04",
      "week": 9,
      "word": "存{ぞん}じる",
      "reading": "ぞんじる",
      "partOfSpeech": "動詞",
      "meaningZh": "【謙讓語】知道、認為（知る・思う）。",
      "examples": [
        {
          "jp": "その件{けん}については存{ぞん}じております。",
          "zh": "關於那件事我知道。"
        },
        {
          "jp": "ご迷惑{めいわく}をおかけしたと存{ぞん}じます。",
          "zh": "我想是給您添麻煩了。"
        }
      ],
      "difficulty": "N2-core",
      "tags": ["謙譲語", "ビジネス"],
      "note": "否定形是「存じません」。對方知道與否要用尊敬語「ご存じですか」。",
      "source": { "type": "original", "label": "自製" }
    },
    {
