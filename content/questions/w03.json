      }
    },
    {
      "id": "q-w03-09",
      "week": 3,
      "skill": "grammar",
      "questionType": "文法形式の判断",
      "stem": "期待{きたい}が大{おお}きかった＿＿、落選{らくせん}の知{し}らせはこたえた。",
      "options": [
        {
          "key": "A",
          "text": "だけに"
        },
        {
          "key": "B",
          "text": "からには"
        },
        {
          "key": "C",
          "text": "うえに"
        },
        {
          "key": "D",
          "text": "ばかりに"
        }
      ],
      "answer": "A",
      "explanationZh": "「～だけに」表示「正因為有這個條件，結果的程度更強」。這裡是期待越大、失望越深。",
      "distractorNotesZh": {
        "B": "「からには」後句要接決心或義務。",
        "C": "「うえに」是追加同方向的事項。",
        "D": "「ばかりに」強調「就因為這一點才招致壞結果」，語氣是後悔，前面通常是負面原因。"
      },
      "relatedGrammarIds": [
        "g-w03-03"
      ],
      "difficulty": "N2-core",
      "tags": [
        "文法形式の判断",
        "強調"
      ],
      "source": {
        "type": "original",
        "label": "自製"
      }
