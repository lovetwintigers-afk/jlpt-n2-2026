    {
      "id": "q-w03-07",
      "week": 3,
      "skill": "grammar",
      "questionType": "文法形式の判断",
      "stem": "現場{げんば}に争{あらそ}った跡{あと}がない＿＿、顔見知{かおみし}りの犯行{はんこう}とみられている。",
      "options": [
        {
          "key": "A",
          "text": "ことだから"
        },
        {
          "key": "B",
          "text": "ことから"
        },
        {
          "key": "C",
          "text": "としては"
        },
        {
          "key": "D",
          "text": "だけに"
        }
      ],
      "answer": "B",
      "explanationZh": "前面是客觀事實、後面是由此推出的判斷，用「～ことから」。前面接的是完整句子而不是「人＋の」，所以不是「ことだから」。",
      "relatedGrammarIds": [
        "g-w03-01",
        "g-w03-02"
      ],
      "difficulty": "N2-core",
      "tags": [
        "文法形式の判断",
        "原因・理由",
        "易混"
      ],
      "source": {
        "type": "original",
        "label": "自製"
      }
    },
    {
      "id": "q-w03-08",
      "week": 3,
      "skill": "grammar",
      "questionType": "文法形式の判断",
      "stem": "几帳面{きちょうめん}な彼女{かのじょ}の＿＿、きっと時間{じかん}どおりに来{く}るだろう。",
      "options": [
        {
          "key": "A",
          "text": "ことから"
        },
        {
          "key": "B",
          "text": "ことなく"
        },
        {
          "key": "C",
          "text": "ことだから"
        },
        {
          "key": "D",
          "text": "ことには"
        }
      ],
      "answer": "C",
      "explanationZh": "前面是「人＋の」，而且後句是根據她的個性做的推測，這是「～ことだから」的典型用法。",
      "distractorNotesZh": {
        "A": "「ことから」前面要接完整句子，依據是事實而非對人的了解。"
      },
      "relatedGrammarIds": [
        "g-w03-02"
      ],
      "difficulty": "N2-core",
      "tags": [
        "文法形式の判断",
        "推量",
