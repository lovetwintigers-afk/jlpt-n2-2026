      "skill": "vocabulary",
      "questionType": "漢字読み",
      "stem": "資材{しざい}が届{とど}かず、工事{こうじ}が滞っている。",
      "options": [
        {
          "key": "A",
          "text": "とどまって"
        },
        {
          "key": "B",
          "text": "たいして"
        },
        {
          "key": "C",
          "text": "とどこおって"
        },
        {
          "key": "D",
          "text": "しぶって"
        }
      ],
      "answer": "C",
      "explanationZh": "「滞る」讀作「とどこおる」，意思是該進行的事情停下來了。",
      "distractorNotesZh": {
        "A": "「留まる」＝停留在某處，漢字不同。",
        "D": "「渋る」＝不情願、拖拖拉拉，主體是人。",
        "B": "「タイ」是音讀，用於「停滞・滞在」，不能單獨接「して」。"
      },
      "relatedVocabIds": [
        "v-w03-01"
      ],
      "difficulty": "N2-core",
